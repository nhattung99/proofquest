# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
PROOFQUEST_POC_ENABLED=false
# Use appId from your current Developer Hub project (deleted project IDs will fail).
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=
# Account Ownership (X), confirmed by owner in Developer Hub.
PRIMUS_TEMPLATE_ID=2e3160ae-8b1e-45e3-8c59-426366278b9d
# Your own EVM address. This experiment does NOT authenticate wallet ownership.
PRIMUS_RECIPIENT=
# Template ID suffices for SDK generation. No manual resolver configuration needed.

# Public verification (configure in Vercel Production only after review).
PROOFQUEST_PUBLIC_VERIFICATION_ENABLED=false
PROOFQUEST_PUBLIC_ORIGIN=https://proofquest-nu.vercel.app
# Dedicated Upstash Redis database: use the standard read/write REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
